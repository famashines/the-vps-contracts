{
  "name": "@famashines/the-vps-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types and schema objects for the-vps, made from @famashines/the-vps-schemas",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/famashines/the-vps-contracts.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@famashines/the-vps-schemas": "github:famashines/the-vps-schemas#v0.1.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
